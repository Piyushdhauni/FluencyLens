<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#171A19"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="35dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FluencyLens."
            android:textColor="#F5F1E8"
            android:textSize="27sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="100dp"
            android:text="ACCOUNT RECOVERY"
            android:textColor="#B7F36B"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Forgot your\npassword?"
            android:textColor="#F5F1E8"
            android:textSize="38sp"
            android:textStyle="bold"
            android:lineSpacingExtra="2dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="No worries. Enter your registered email address and we'll help you reset your password."
            android:textColor="#A6AAA6"
            android:textSize="15sp"
            android:lineSpacingExtra="5dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="45dp"
            android:text="Email address"
            android:textColor="#F5F1E8"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/recoveryEmailInput"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_login_input"
            android:hint="Enter your registered email"
            android:inputType="textEmailAddress"
            android:paddingStart="17dp"
            android:paddingEnd="17dp"
            android:textColor="#F5F1E8"
            android:textColorHint="#858B86"
            android:textSize="15sp"/>

        <TextView
            android:id="@+id/resetPasswordBtn"
            android:layout_width="match_parent"
            android:layout_height="57dp"
            android:layout_marginTop="30dp"
            android:background="@drawable/bg_login_button"
            android:gravity="center"
            android:text="Send reset link"
            android:textColor="#171A19"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/backToLogin"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="← Back to sign in"
            android:textColor="#B7F36B"
            android:textSize="14sp"
            android:textStyle="bold"/>

    </LinearLayout>
</ScrollView>
