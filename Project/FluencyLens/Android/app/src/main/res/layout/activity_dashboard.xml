<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#171A19">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp">

            <!-- Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FLUENCYLENS"
                android:textColor="#B7F36B"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.15"/>

            <TextView
                android:id="@+id/dashboardName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Welcome back!"
                android:textColor="#F5F1E8"
                android:textSize="27sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Ready to improve your English?"
                android:textColor="#A6AAA6"
                android:textSize="14sp"/>

            <!-- Fluency Score -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="#252827"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="YOUR FLUENCY SCORE"
                    android:textColor="#A6AAA6"
                    android:textSize="12sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/dashboardScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="--"
                    android:textColor="#B7F36B"
                    android:textSize="48sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Complete a speaking session to get your score."
                    android:textColor="#A6AAA6"
                    android:textSize="13sp"/>

            </LinearLayout>

            <!-- Daily Goal -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="#252827"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DAILY SPEAKING GOAL"
                    android:textColor="#F5F1E8"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/dailyGoalText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="0 / 15 minutes"
                    android:textColor="#B7F36B"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

            </LinearLayout>

            <!-- Learning Space -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="YOUR LEARNING SPACE"
                android:textColor="#F5F1E8"
                android:textSize="17sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/practiceCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="#252827"
                android:padding="20dp"
                android:text="AI SPEAKING PRACTICE\n\nSpeak naturally with your AI English coach.\n\nSTART PRACTISING  →"
                android:textColor="#F5F1E8"
                android:textSize="16sp"
                android:lineSpacingExtra="5dp"/>

            <TextView
                android:id="@+id/interviewCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#252827"
                android:padding="20dp"
                android:text="INTERVIEW PREPARATION\n\nPractise interview questions and improve your professional communication.\n\nEXPLORE  →"
                android:textColor="#F5F1E8"
                android:textSize="16sp"
                android:lineSpacingExtra="5dp"/>

            <TextView
                android:id="@+id/progressCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#252827"
                android:padding="20dp"
                android:text="YOUR PROGRESS\n\nTrack your fluency, speaking pace and filler words.\n\nVIEW PROGRESS  →"
                android:textColor="#F5F1E8"
                android:textSize="16sp"
                android:lineSpacingExtra="5dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:text="Every conversation makes you better."
                android:textColor="#A6AAA6"
                android:textSize="12sp"/>

        </LinearLayout>
    </ScrollView>

    <!-- Floating Bottom Navigation -->
    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="82dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_bottom_nav"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="8dp"
        android:elevation="8dp">


        <!-- Home -->
        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_house"
                android:tint="#B7F36B"
                android:contentDescription="Home"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textColor="#B7F36B"
                android:textSize="12sp"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- Practice -->
        <LinearLayout
            android:id="@+id/navPractice"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_practice"
                android:tint="#A6AAA6"
                android:contentDescription="Practice"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Practice"
                android:textColor="#A6AAA6"
                android:textSize="12sp"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- Progress -->
        <LinearLayout
            android:id="@+id/navProgress"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_progress"
                android:tint="#A6AAA6"
                android:contentDescription="Progress"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Progress"
                android:textColor="#A6AAA6"
                android:textSize="12sp"
                android:singleLine="true"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- Achievements -->
        <LinearLayout
            android:id="@+id/navAchievements"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_achievements"
                android:tint="#A6AAA6"
                android:contentDescription="Achievements"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Achievements"
                android:textColor="#A6AAA6"
                android:textSize="10sp"
                android:singleLine="true"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- Profile -->
        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_profile"
                android:tint="#A6AAA6"
                android:contentDescription="Profile"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profile"
                android:textColor="#A6AAA6"
                android:textSize="12sp"
                android:layout_marginTop="4dp"/>
        </LinearLayout>


    </LinearLayout>

</LinearLayout>
