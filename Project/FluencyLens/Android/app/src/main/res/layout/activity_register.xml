<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#171A19"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="40dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FluencyLens."
            android:textColor="#F5F1E8"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="45dp"
            android:text="START YOUR JOURNEY."
            android:textColor="#B7F36B"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Create your\naccount."
            android:textColor="#F5F1E8"
            android:textSize="36sp"
            android:textStyle="bold"
            android:lineSpacingExtra="2dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Your journey towards confident English starts here."
            android:textColor="#A6AAA6"
            android:textSize="15sp" />

        <!-- Full name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Full name"
            android:textColor="#F5F1E8"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/nameInput"
            android:importantForAutofill="no"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_login_input"
            android:hint="Enter your full name"
            android:inputType="textPersonName"
            android:paddingStart="17dp"
            android:paddingEnd="17dp"
            android:textColor="#F5F1E8"
            android:textColorHint="#858B86"
            android:textSize="15sp" />

        <!-- Email -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Email address"
            android:textColor="#F5F1E8"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/registerEmailInput"
            android:importantForAutofill="no"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_login_input"
            android:hint="Enter your email"
            android:inputType="textEmailAddress"
            android:paddingStart="17dp"
            android:paddingEnd="17dp"
            android:textColor="#F5F1E8"
            android:textColorHint="#858B86"
            android:textSize="15sp" />

        <!-- Password -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Password"
            android:textColor="#F5F1E8"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/registerPasswordInput"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_login_input"
            android:hint="Create a password"
            android:inputType="textPassword"
            android:paddingStart="17dp"
            android:paddingEnd="17dp"
            android:textColor="#F5F1E8"
            android:textColorHint="#858B86"
            android:textSize="15sp" />

        <!-- Confirm password -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Confirm password"
            android:textColor="#F5F1E8"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/confirmPasswordInput"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_login_input"
            android:hint="Re-enter your password"
            android:inputType="textPassword"
            android:paddingStart="17dp"
            android:paddingEnd="17dp"
            android:textColor="#F5F1E8"
            android:textColorHint="#858B86"
            android:textSize="15sp" />

        <!-- Create account button -->
        <TextView
            android:id="@+id/createAccountBtn"
            android:layout_width="match_parent"
            android:layout_height="57dp"
            android:layout_marginTop="30dp"
            android:background="@drawable/bg_login_button"
            android:gravity="center"
            android:text="Create account"
            android:textColor="#171A19"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Sign in link -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="27dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Already have an account? "
                android:textColor="#A6AAA6"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/signInLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sign in"
                android:textColor="#B7F36B"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
